{
  "name": "goprodbackend",
  "version": "1.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run format:check",
    "format:fix": "turbo run format:fix",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "packageManager": "bun@1.3.4",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "pacakges/*"
  ],
  "devDependencies": {
    "turbo": "^2.8.17",
    "typescript": "^5.9.3"
  }
}
